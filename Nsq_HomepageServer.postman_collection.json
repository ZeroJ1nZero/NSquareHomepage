{
  "info": {
    "_postman_id": "d1282ade-b37c-474c-a017-bdabe376c429",
    "name": "Nsq_HomepageServer",
    "description": "엔스퀘어 사내 통합 홈페이지 & SSO 시스템 (ServiceServer, ResourceServer, AuthServer)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "26203024"
  },
  "item": [
    {
      "name": "1. SSO 인증 (Auth & Session)",
      "item": [
        {
          "name": "SSO 로그인 시작 (PKCE & IdP URL 발급)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/auth/login",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "PKCE pair(code_verifier, code_challenge)와 CSRF state를 생성하고 IdP Authorization URL을 반환합니다."
          },
          "response": []
        },
        {
          "name": "OIDC 토큰 교환 & 서비스 세션 발급",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{auth_code}}\",\n  \"code_verifier\": \"{{code_verifier}}\",\n  \"redirect_uri\": \"https://localhost:7001/signin-oidc\"\n}"
            },
            "url": {
              "raw": "{{serviceUrl}}/signin-oidc",
              "host": ["{{serviceUrl}}"],
              "path": ["signin-oidc"]
            },
            "description": "IdP에서 발급받은 인가 코드와 code_verifier로 백채널 토큰 교환 후 서비스 세션 쿠키를 발급받습니다."
          },
          "response": []
        },
        {
          "name": "현재 세션 사용자 정보 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/auth/me",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "현재 로그인된 세션 쿠키의 사용자 클레임 정보를 확인합니다."
          },
          "response": []
        },
        {
          "name": "전역 로그아웃 (Global Logout)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/auth/logout",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "서비스 세션을 파기하고 IdP 전역 로그아웃 URL을 반환합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. 회사 소개 (About)",
      "item": [
        {
          "name": "[트랙 A] 회사 소개 조회 (공개)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/Home/about",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "about"]
            },
            "description": "로그인 없이 누구나 회사 소개 정보를 조회할 수 있습니다."
          },
          "response": []
        },
        {
          "name": "[트랙 B] 회사 소개 저장 (관리자 세션 필요)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"introduction\": \"엔스퀘어 최신 회사소개 내용입니다.\"\n}"
            },
            "url": {
              "raw": "{{serviceUrl}}/api/Home/about",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "about"]
            },
            "description": "관리자 세션 쿠키를 검증하고 ResourceServer에 Access Token을 전달하여 회사 소개를 수정합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. 회사 서비스 (Service)",
      "item": [
        {
          "name": "[트랙 A] 회사 서비스 조회 (공개)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/Home/service",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "service"]
            },
            "description": "로그인 없이 누구나 주요 서비스 정보를 조회할 수 있습니다."
          },
          "response": []
        },
        {
          "name": "[트랙 B] 회사 서비스 저장 (관리자 세션 필요)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"클라우드 보안 및 SSO 통합 솔루션\"\n}"
            },
            "url": {
              "raw": "{{serviceUrl}}/api/Home/service",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "service"]
            },
            "description": "관리자 세션 쿠키를 검증하고 ResourceServer에 Access Token을 전달하여 서비스 정보를 수정합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. 회사 연혁 (History)",
      "item": [
        {
          "name": "[트랙 A] 전체 연혁 목록 조회 (공개)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serviceUrl}}/api/Home/history",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "history"]
            },
            "description": "로그인 없이 누구나 전체 연혁 목록을 조회할 수 있습니다."
          },
          "response": []
        },
        {
          "name": "[트랙 B] 연혁 항목 저장/추가 (관리자 세션 필요)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"history\": [\n    {\n      \"data\": \"2026-08-18\",\n      \"content\": \"SSO 2-Track 파이프라인 및 리소스 서버 분리 구축 완료\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{serviceUrl}}/api/Home/history",
              "host": ["{{serviceUrl}}"],
              "path": ["api", "Home", "history"]
            },
            "description": "관리자 세션 쿠키를 검증하고 ResourceServer에 Access Token을 전달하여 연혁 항목을 저장합니다."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "serviceUrl",
      "value": "https://localhost:7001",
      "type": "string"
    },
    {
      "key": "resourceUrl",
