<mxfile host="app.diagrams.net">
  <diagram name="로그인 흐름 (단계별)" id="auth-flow-simple">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 범례 -->
        <mxCell id="legend" value="🔵 사용자가 직접 하는 행동 (단 2개)&#10;⚪ 나머지는 전부 자동 (리다이렉트/서버 처리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- 1. 시작: 사용자 행동 1 -->
        <mxCell id="n1" value="🔵 사용자 행동 ①&#10;클라이언트(:7001) 화면에서 [로그인] 버튼 클릭&#10;— 사용자가 누르는 버튼은 여기 하나뿐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 2. 자동 이동 -->
        <mxCell id="n2" value="(자동) 브라우저가 인증서버로 이동&#10;GET /connect/authorize?client_id=...&amp;redirect_uri=...&amp;code_challenge=...&#10;※ 로그인 페이지가 아니라 authorize로 간다!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 3. 분기 -->
        <mxCell id="d1" value="세션 쿠키&#10;있음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="490" y="260" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- 없음 경로 (왼쪽) -->
        <mxCell id="n3" value="(자동) /login 화면으로 리다이렉트&#10;복귀 주소(returnUrl)에 위 authorize 요청 전체를 보관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="🔵 사용자 행동 ②&#10;아이디/비밀번호 입력 후 제출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="(자동) 해시 검증 성공 → 세션 쿠키 발급&#10;→ 보관해둔 returnUrl(authorize)로 자동 복귀&#10;※ 버튼을 다시 누를 필요 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- 6. 코드 발급 -->
        <mxCell id="n6" value="(자동) 인증서버: 일회용 인가 코드 생성&#10;+ DB(OpenIddictTokens)에 장부 기록&#10;&quot;code=abc123, 미사용(valid), 몇 분 뒤 만료&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 7. 콜백 -->
        <mxCell id="n7" value="(자동) 브라우저가 클라이언트 콜백으로 이동&#10;https://localhost:7001/signin-oidc?code=abc123&#10;⚠ 이 구간은 URL — 히스토리/로그에 남는 새기 쉬운 통로" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="590" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 8. 토큰 교환 -->
        <mxCell id="n8" value="(자동) 클라이언트 → 인증서버 직접 요청&#10;POST /connect/token (code=abc123 + PKCE 원본값)&#10;※ URL이 아닌 요청 본문 — 밖에서 안 보임" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="710" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 9. 검증 -->
        <mxCell id="n9" value="(자동) 인증서버: 장부 대조&#10;내가 발급한 코드? 아직 미사용? 만료 전? PKCE 원본 일치?&#10;→ 전부 통과 시 코드를 '사용됨(redeemed)'으로 도장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="830" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 10. 완료 -->
        <mxCell id="n10" value="토큰 3종을 응답으로 전달 → 클라이언트 로그인 완료&#10;· id_token — 누가 로그인했나 (이름·이메일·역할)&#10;· access token(15분) — API 호출용&#10;· refresh token(14일) — 만료 시 재발급용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="950" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- 설명 박스: 왜 코드? -->
        <mxCell id="whyCode" value="❓ 왜 토큰을 바로 안 주고 일회용 코드를 거치나&#10;&#10;토큰을 URL로 바로 주면: URL은 브라우저 히스토리·서버 로그·&#10;Referer에 남는다 → 14일짜리 refresh token이 통째로 유출될 수 있음&#10;&#10;그래서 새기 쉬운 URL 구간에는 '혼자서는 쓸모없는 교환권(코드)'만&#10;보내고, 진짜 귀중품(토큰)은 직접 요청(POST)의 응답으로만 준다&#10;&#10;코드가 유출돼도 공격자는 못 쓴다:&#10;① 몇 분 뒤 만료  ② 한 번 쓰면 무효(redeemed)&#10;③ PKCE 원본값이 없으면 교환 거부" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="590" width="380" height="230" as="geometry" />
        </mxCell>

        <!-- SSO 박스 -->
        <mxCell id="ssoNote" value="⭐ SSO: 두 번째 서비스에서 로그인 버튼을 누르면&#10;①→②→쿠키 있음→⑥으로 직행.&#10;로그인 화면(왼쪽 경로)이 아예 등장하지 않는다.&#10;사용자 눈에는 &quot;클릭 한 번에 로그인됨&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="380" height="110" as="geometry" />
        </mxCell>

        <!-- 화살표 -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="n2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="없음" style="endArrow=block;html=1;fontSize=12;fontStyle=1" edge="1" parent="1" source="d1" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="이번엔 쿠키 있음" style="endArrow=block;html=1;fontSize=12;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="있음 → 로그인 화면 생략 (SSO)" style="endArrow=block;html=1;fontSize=12;fontStyle=1" edge="1" parent="1" source="d1" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
